# --- Contact form (api/contact.js) ---------------------------------------------
# SMTP account used to deliver contact-form messages to CONTACT_TO.
# For Gmail use smtp.gmail.com:587 with an App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
# Optional: From address (defaults to SMTP_USER) and recipient (defaults to bodymappeptide@gmail.com)
SMTP_FROM=
CONTACT_TO=
# Optional: extra comma-separated origins allowed to call /api/contact (same-origin always works)
CONTACT_ALLOWED_ORIGINS=https://peptide-map.vercel.app

# --- Research search (optional) ------------------------------------------------
# js/config.js currently ships API keys in the browser bundle. Prefer rotating them and
# proxying requests through a server route instead of keeping real keys client-side.
PUBMED_API_KEY=your_pubmed_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
